  "advanced_config": "access_log off;\nerror_log /dev/null crit;\nproxy_buffering off;\nproxy_request_buffering off;\nproxy_read_timeout 900s;\nproxy_send_timeout 900s;\nsend_timeout 900s;\nclient_max_body_size 32k;",
  "locations": [
    {
      "path": "/",
      "forward_scheme": "http",
      "forward_host": "192.168.50.90",
      "forward_port": 7766,
      "advanced_config": "proxy_http_version 1.1;\naccess_log off;\nerror_log /dev/null crit;"
    }
  ]
}
