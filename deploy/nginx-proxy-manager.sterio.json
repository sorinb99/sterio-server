{
  "domain_names": ["sterio.filmescu.ro"],
  "forward_scheme": "http",
  "forward_host": "192.168.50.90",
  "forward_port": 7766,
  "access_list_id": 0,
  "caching_enabled": false,
  "block_exploits": true,
